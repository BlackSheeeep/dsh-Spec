{
  "name": "dsh-spec",
  "version": "0.1.0",
  "private": true,
  "description": "OpenSpec 工作流的 DSH 适配插件：openspec/ 目录监控面板 + 会话快捷命令条 + /opsx-* 阶段命令桥接。",
  "type": "module",
  "main": "lib/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/space-spacee-clamation/dsh-Spec.git"
  },
  "homepage": "https://github.com/space-spacee-clamation/dsh-Spec",
  "bugs": {
    "url": "https://github.com/space-spacee-clamation/dsh-Spec/issues"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "tools",
    "tests",
    "docs",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tests/*.test.mjs\""
  },
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives"
      ]
    }
  },
  "license": "MIT"
}
